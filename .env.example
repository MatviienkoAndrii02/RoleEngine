DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/role_engine?schema=public"
AUTH_SECRET="replace-me"
AUTH_TRUST_HOST=true

# Admin Console (/admin, /admin-api). ADMIN_ACCOUNTS is required: without it the
# console denies every account. Values are emails or account ids.
ADMIN_ACCOUNTS=""
ADMIN_BACKUP_DIR=""
# Windows example: ADMIN_PG_DUMP_PATH="C:\\Program Files\\PostgreSQL\\18\\bin\\pg_dump.exe"
ADMIN_PG_DUMP_PATH=""
# Optional; defaults to pg_restore next to the configured pg_dump.
ADMIN_PG_RESTORE_PATH=""
# Leave empty for internet access. LAN-only mode: "127.0.0.1/32,192.168.0.0/16,::1"
ADMIN_ALLOWED_IP_RANGES=""
ADMIN_IP_HEADER=""
NEXT_PUBLIC_ADMIN_API_BASE="/admin-api"
# Optional real deployment metadata shown in the console and stored in backup manifests.
APP_VERSION=""
APP_COMMIT=""
